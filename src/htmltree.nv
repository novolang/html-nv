// htmltree.nv — the document, as a flat arena of nodes over the
// source.
//
// The nodes are one list, and a node refers to its parent, its first
// and last child and its two siblings by index.  Index 0 is the
// document node.  A walk is a loop over indices, and an index is stable
// for the life of the document.
//
// Names and text are byte ranges into `HtmlDoc.source`, which is the
// caller's source after the preprocessing of WHATWG HTML section
// 13.2.3.5: each CR LF pair and each lone CR is a LF, and every tag and
// attribute name is in lower case.  HTML matches names ASCII
// case-insensitively (section 13.2.5.8), so lowering them changes no
// meaning, and it keeps every other byte where it was.  A text node or
// an attribute value that holds a character reference, such as
// `&amp;`, is not the text its bytes spell, and `needs_decoding` says
// so; `text_of` and `attr` decode.

use std.str
use htmlentity

// NO_NODE is the index that means there is no node.
//
// ```novo
// use htmltree
//
// fn main() [io]
//     println("${htmltree.NO_NODE}")   // -1
// ```
pub const NO_NODE = 0 - 1

// HtmlRange is a byte range into the document's source: `start` is the
// first byte and `end` one past the last.
pub struct HtmlRange
    start: Int
    end: Int

// HtmlAttr is one attribute of an element.
pub struct HtmlAttr
    // The name, in lower case.
    name: HtmlRange
    // The value as written, without its quotes.  Empty for an attribute
    // written without a value, which is present and not absent:
    // `<input disabled>` has `disabled` with an empty value.
    value: HtmlRange
    // Whether the value holds a character reference.
    needs_decoding: Bool

// HtmlKind is what a node is.
pub enum HtmlKind
    // The document node.  There is one, at index 0.
    HtmlDocument
    // An element: its tag name in lower case, and its attributes in the
    // order written.  A name written twice keeps both, and the first is
    // the one `attr` answers, as HTML's parser does.
    HtmlElement(tag: HtmlRange, attrs: [HtmlAttr])
    // A run of characters.
    HtmlText(text: HtmlRange, needs_decoding: Bool)
    // A comment's text, without `<!--` and `-->`.
    HtmlComment(text: HtmlRange)
    // A doctype, and the name it declared in lower case.
    HtmlDoctype(name: HtmlRange)

// HtmlNode is one node of the arena.  Every link is an index, and
// `NO_NODE` where there is none.
pub struct HtmlNode
    kind: HtmlKind
    parent: Int
    first_child: Int
    last_child: Int
    next_sibling: Int
    previous_sibling: Int
    // The bytes the node took in the source, its end tag included.  An
    // element closed by something else ends where that something
    // begins.
    span: HtmlRange

// HtmlDoc is a parsed document: the source, the arena, and what the
// parser recovered from.
pub struct HtmlDoc
    // The source every range points into (see the module comment).
    source: Str
    nodes: [HtmlNode]
    // Every place the document was not well-formed and the parser
    // recovered, in source order.
    issues: [HtmlIssue]
    // Whether an `HtmlLimits` bound was reached, so that the rest of the
    // document was not parsed.
    truncated: Bool

// HtmlIssue is one recovery the parser made, and where.
pub struct HtmlIssue
    // The byte offset in the source.
    at: Int
    kind: HtmlIssueKind

// HtmlIssueKind is what was wrong.
pub enum HtmlIssueKind
    // An end tag with no element to close.  It is dropped.
    IssueStrayEndTag(tag: HtmlRange)
    // An element that was open when something else closed it, or when
    // the document ended.  An element whose end tag HTML lets a document
    // leave out, such as `p` and `li`, is not reported.
    IssueUnclosedElement(tag: HtmlRange)
    // A second element with an `id` another element already has.
    IssueDuplicateId(id: HtmlRange)
    // A character reference that is not well-formed: a missing
    // semicolon, an unknown name followed by `;`, a `&#` with no digit,
    // or a number that is not a Unicode scalar value.
    IssueBadCharacterReference(at: HtmlRange)
    // A construct of tree construction this package does not implement:
    // misnested formatting, content foster-parented out of a table, a
    // `template`, or `svg` and `math`.  `what` is the tag or the text.
    IssueUnsupportedConstruct(what: HtmlRange)
    // A `/>` on an element that is not void.  It is ignored, as HTML
    // says (section 13.2.6.1), so the element stays open.
    IssueSelfClosingNonVoid(tag: HtmlRange)

// root is the document node's index, which is 0.
//
// ```novo
// use htmltree
// use htmlparse
//
// fn main() [io]
//     println("${htmltree.root(htmlparse.parse("x"))}")   // 0
// ```
pub fn root(doc: HtmlDoc) -> Int []
    0

// count is how many nodes the document holds, the document node
// included.
//
// ```novo
// use htmltree
// use htmlparse
//
// fn main() [io]
//     println("${htmltree.count(htmlparse.parse("<p>a</p>"))}")   // 3
// ```
pub fn count(doc: HtmlDoc) -> Int []
    list.len(doc.nodes)

// node is the node at an index, or `None` for an index outside the
// document.
//
// ```novo
// use htmltree
// use htmlparse
//
// fn main() [io]
//     println("${htmltree.node(htmlparse.parse("x"), 9) == None}")   // true
// ```
pub fn node(doc: HtmlDoc, index: Int) -> ?HtmlNode []
    if index < 0 or index >= list.len(doc.nodes)
        return None
    Some(doc.nodes[index])

// children is the indices of a node's children, in order.
//
// `first_child` and `next_sibling` are the same walk with no list.
//
// ```novo
// use htmltree
// use htmlparse
//
// fn main() [io]
//     let doc = htmlparse.parse("<ul><li>a<li>b</ul>")
//     println("${list.len(htmltree.children(doc, 1))}")   // 2
// ```
pub fn children(doc: HtmlDoc, index: Int) -> [Int] []
    var out: [Int] = []
    if index < 0 or index >= list.len(doc.nodes)
        return out
    var c = doc.nodes[index].first_child
    while c != NO_NODE
        out = list.push(out, c)
        c = doc.nodes[c].next_sibling
    out

// The text a range covers in the source.
fn range_str(doc: HtmlDoc, r: HtmlRange) -> Str
    str.slice(doc.source, r.start, r.end)

// tag_name is an element's tag name in lower case, or an empty string
// for a node that is not an element.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     let doc = htmlparse.parse("<P>hi</P>")
//     println(htmltree.tag_name(doc, 1))   // p
// ```
pub fn tag_name(doc: HtmlDoc, index: Int) -> Str []
    match node(doc, index)
        Some(n) =>
            match n.kind
                HtmlElement(tag, _) => range_str(doc, tag)
                _                   => ""
        None    => ""

// The attributes of an element, or none for any other node.
fn attrs_of(doc: HtmlDoc, index: Int) -> readonly [HtmlAttr]
    match node(doc, index)
        Some(n) =>
            match n.kind
                HtmlElement(_, attrs) => attrs
                _                     => []
        None    => []

// Whether a range of the source spells a name, compared ASCII
// case-insensitively.
fn range_is(doc: HtmlDoc, r: HtmlRange, name: Str) -> Bool
    if r.end - r.start != str.len(name)
        return false
    for k in 0..str.len(name)
        if str.byte_at_or(doc.source, r.start + k, 0) != lower(str.byte_at_or(name, k, 0))
            return false
    true

// A byte with ASCII upper case lowered.
fn lower(b: Int) -> Int
    if b >= 'A' and b <= 'Z'
        return b + 32
    b

// The decoded value of an attribute.
fn attr_value(doc: HtmlDoc, a: HtmlAttr) -> Str
    if a.needs_decoding
        return htmlentity.decode_scan(doc.source, a.value.start, a.value.end, true).text
    range_str(doc, a.value)

// attr is the decoded value of an element's attribute, or `None` when
// the element does not have it.
//
// The name is matched ASCII case-insensitively.  An attribute written
// without a value answers `Some("")`.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     let doc = htmlparse.parse("<a href='/x?a=1&amp;b=2'>t</a>")
//     println(htmltree.attr(doc, 1, "HREF") ?? "absent")   // /x?a=1&b=2
// ```
pub fn attr(doc: HtmlDoc, index: Int, name: Str) -> ?Str []
    for a in attrs_of(doc, index)
        if range_is(doc, a.name, name)
            return Some(attr_value(doc, a))
    None

// has_attr says whether an element has an attribute, with or without a
// value.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     println("${htmltree.has_attr(htmlparse.parse("<input disabled>"), 1, "disabled")}")   // true
// ```
pub fn has_attr(doc: HtmlDoc, index: Int, name: Str) -> Bool []
    attr(doc, index, name) != None

// Whether a byte is ASCII whitespace as HTML defines it: tab, line
// feed, form feed, carriage return and space.
fn is_space(b: Int) -> Bool
    b == ' ' or b == '\t' or b == '\n' or b == 12 or b == '\r'

// The words of a string separated by ASCII whitespace.
fn words(s: Str) -> [Str]
    var out: [Str] = []
    var start = -1
    let n = str.len(s)
    for i in 0..n + 1
        let space = i == n or is_space(str.byte_at_or(s, i, 0))
        if space and start >= 0
            out = list.push(out, str.slice(s, start, i))
            start = -1
        if not space and start < 0
            start = i
    out

// classes is an element's `class` attribute split on ASCII whitespace,
// or an empty list.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     let doc = htmlparse.parse("<p class=' a  b '>x</p>")
//     println(str.join(htmltree.classes(doc, 1), ","))   // a,b
// ```
pub fn classes(doc: HtmlDoc, index: Int) -> [Str] []
    words(attr(doc, index, "class") ?? "")

// text_of is a text node's text, with its character references
// decoded, or an empty string for any other node.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     let doc = htmlparse.parse("<p>a &lt; b</p>")
//     println(htmltree.text_of(doc, 2))   // a < b
// ```
pub fn text_of(doc: HtmlDoc, index: Int) -> Str []
    match node(doc, index)
        Some(n) =>
            match n.kind
                HtmlText(text, needs_decoding) =>
                    if needs_decoding
                        return htmlentity.decode_scan(doc.source, text.start, text.end, false).text
                    range_str(doc, text)
                _                              => ""
        None    => ""

// inner_text is the text of every text node under a node, in document
// order, decoded.
//
// The text inside `script` and `style` elements is left out: it is code
// and not prose.
//
// ```novo
// use htmlparse
// use htmltree
//
// fn main() [io]
//     let doc = htmlparse.parse("<p>a<b>b</b><style>x</style>c</p>")
//     println(htmltree.inner_text(doc, 1))   // abc
// ```
pub fn inner_text(doc: HtmlDoc, index: Int) -> Str []
    let sb = str.builder_new()
    append_text(doc, index, sb)
    let out = str.builder_to_str(sb)
    str.builder_drop(sb)
    out

// Appends the text under a node to a builder.
fn append_text(doc: HtmlDoc, index: Int, sb: Int)
    for c in children(doc, index)
        let n = doc.nodes[c]
        match n.kind
            HtmlText(_, _)    =>
                let _ = str.builder_append(sb, text_of(doc, c))
            HtmlElement(_, _) =>
                let tag = tag_name(doc, c)
                if tag != "script" and tag != "style"
                    append_text(doc, c, sb)
            _                 => ()

// is_void says whether a tag name is one of HTML's void elements, the
// thirteen that never have children or an end tag: `area base br col
// embed hr img input link meta source track wbr` (section 13.1.2).
//
// ```novo
// use htmltree
//
// fn main() [io]
//     println("${htmltree.is_void("br")}")   // true
// ```
pub fn is_void(tag: Str) -> Bool []
    match tag
        "area"   => true
        "base"   => true
        "br"     => true
        "col"    => true
        "embed"  => true
        "hr"     => true
        "img"    => true
        "input"  => true
        "link"   => true
        "meta"   => true
        "source" => true
        "track"  => true
        "wbr"    => true
        _        => false

// Whether a tag never has children when parsed: the void elements and
// the obsolete `basefont`, `bgsound`, `frame`, `keygen` and `param`,
// which HTML's parser and serialiser treat the same way.
fn childless(tag: Str) -> Bool
    is_void(tag) or tag == "basefont" or tag == "bgsound" or tag == "frame" or tag == "keygen" or tag == "param"

// is_raw_text says whether an element's contents are text rather than
// markup: `script`, `style`, `textarea`, `title`, `xmp`, `iframe`,
// `noembed`, `noframes` and `plaintext`.
//
// A `<` inside one of them is a `<`.  A sanitiser that removes a
// `script` removes its contents too, because unwrapping it would leave
// the code on the page as text.
//
// ```novo
// use htmltree
//
// fn main() [io]
//     println("${htmltree.is_raw_text("textarea")}")   // true
// ```
pub fn is_raw_text(tag: Str) -> Bool []
    match tag
        "script"    => true
        "style"     => true
        "textarea"  => true
        "title"     => true
        "xmp"       => true
        "iframe"    => true
        "noembed"   => true
        "noframes"  => true
        "plaintext" => true
        _           => false
