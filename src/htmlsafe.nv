// htmlsafe.nv — escaping, unescaping, and sanitising.
//
// Escaping turns text into markup that renders as that text: `<`
// becomes `&lt;` and so on.  It is total, every input has an escaped
// form, and it needs no tree.  It is for text that was never meant to
// be markup.
//
// Sanitising takes a document that is markup and removes what the
// publisher may not write.  It is lossy, and it needs a tree: "the
// `href` of every `a` element" is something a tree can answer and a
// search through a string cannot, because the same bytes appear in
// code samples and in text.  The policy is an `HtmlAllowList`, a value
// a caller starts from one of three named lists and changes.
//
// A URL is checked the way a browser reads it: character references
// decoded, leading and trailing spaces and control characters removed,
// tabs and line breaks removed, and the scheme compared without regard
// to ASCII case.  `java&#09;script:` and `  JavaScript:` are both
// `javascript:` to a browser, and both are refused here.

use std.str
use std.bytes
use htmltree
use htmlentity

// HtmlAttrRule says which attributes an element keeps.
pub struct HtmlAttrRule
    // The element the rule is for, or `"*"` for every element.
    tag: Str
    // The names of the attributes kept, in lower case.
    attrs: [Str]
    // The attributes among `attrs` whose value is a URL and must pass
    // `safe_url`, such as `href` on `a` and `src` on `img`.
    url_attrs: [Str]

// HtmlAllowList is a sanitising policy, as data.
pub struct HtmlAllowList
    // The element names kept.  Any other element is unwrapped: removed,
    // with its children kept in its place, unless it is in
    // `strip_contents_of`.
    tags: [Str]
    attrs: [HtmlAttrRule]
    // The schemes a URL attribute may use, in lower case and without
    // the colon.
    url_schemes: [Str]
    // Whether a URL with no scheme, such as `#part`, `/docs/a.html` or
    // `a.html`, is allowed.
    allow_relative_urls: Bool
    // What a refused URL is replaced with.
    refused_url: Str
    // The elements removed together with their contents.  `script` and
    // `style` belong here: their contents are code, and unwrapping them
    // would leave the code on the page as text.
    strip_contents_of: [Str]
    // Whether comments are kept.
    keep_comments: Bool
    // The `rel` value an `a` element with an absolute URL gets, or an
    // empty string for none.  `"nofollow noopener"` is what a site that
    // shows other people's links wants.
    link_rel: Str

// The elements every named list strips with their contents.
fn stripped() -> [Str]
    ["script",
        "style",
        "template",
        "iframe",
        "object",
        "embed",
        "noscript",
        "noembed",
        "noframes",
        "svg",
        "math",
        "title"]

// allow_none keeps no element, so a document becomes its text.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.len(htmlsafe.allow_none().tags)}")   // 0
// ```
pub fn allow_none() -> HtmlAllowList []
    HtmlAllowList {
        tags: [], attrs: [], url_schemes: web_schemes(), allow_relative_urls: true,
        refused_url: "#", strip_contents_of: stripped(), keep_comments: false, link_rel: "" }

// allow_basic keeps paragraphs, lists, headings, quotations, code and
// inline emphasis, and links with their `href`.  No images, no tables,
// and no `style`, `class` or `id`.  The list for a comment box.
//
// `p br em strong code pre blockquote ul ol li h1 h2 h3 h4 h5 h6 a hr`
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.contains(htmlsafe.allow_basic().tags, "img")}")   // false
// ```
pub fn allow_basic() -> HtmlAllowList []
    HtmlAllowList {
        tags: ["p", "br", "em", "strong", "code", "pre", "blockquote", "ul", "ol", "li",
               "h1", "h2", "h3", "h4", "h5", "h6", "a", "hr"],
        attrs: [HtmlAttrRule { tag: "a", attrs: ["href"], url_attrs: ["href"] }],
        url_schemes: web_schemes(), allow_relative_urls: true, refused_url: "#",
        strip_contents_of: stripped(), keep_comments: false, link_rel: "nofollow noopener" }

// allow_readme is `allow_basic` and what a rendered README needs:
// tables, images, `id` on headings so that links to a section work,
// `class` on `code` for a highlighter's `language-*`, and `b`, `i`,
// `s`, `del`, `ins`, `sub`, `sup`, `kbd`, `dl`, `dt` and `dd`.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.contains(htmlsafe.allow_readme().tags, "img")}")   // true
// ```
pub fn allow_readme() -> HtmlAllowList []
    let basic = allow_basic()
    let extra = ["table", "thead", "tbody", "tfoot", "tr", "th", "td", "caption", "img",
                 "b", "i", "s", "del", "ins", "sub", "sup", "kbd", "dl", "dt", "dd"]
    var rules = basic.attrs[:]
    rules = list.push(rules, HtmlAttrRule { tag: "img",
        attrs: ["src", "alt", "title", "width", "height"],
        url_attrs: ["src"] })
    rules = list.push(rules, HtmlAttrRule { tag: "code", attrs: ["class"], url_attrs: [] })
    for h in ["h1", "h2", "h3", "h4", "h5", "h6"]
        rules = list.push(rules, HtmlAttrRule { tag: h, attrs: ["id"], url_attrs: [] })
    for cell in ["th", "td"]
        rules = list.push(rules, HtmlAttrRule { tag: cell, attrs: ["align", "colspan", "rowspan"], url_attrs: [] })
    HtmlAllowList {
        tags: list.concat(basic.tags, extra), attrs: rules, url_schemes: basic.url_schemes,
        allow_relative_urls: true, refused_url: "#", strip_contents_of: stripped(),
        keep_comments: false, link_rel: basic.link_rel }

// web_schemes is the four schemes a published document may link to:
// `http`, `https`, `mailto` and `tel`.
//
// `data` is not among them, because a `data:` URL in an `href` can
// hold a script.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println(str.join(htmlsafe.web_schemes(), " "))   // http https mailto tel
// ```
pub fn web_schemes() -> [Str] []
    ["http", "https", "mailto", "tel"]

// A copy of a list with different tags.
fn with_tags(allow: HtmlAllowList, tags: [Str]) -> HtmlAllowList
    HtmlAllowList {
        tags: tags, attrs: allow.attrs, url_schemes: allow.url_schemes,
        allow_relative_urls: allow.allow_relative_urls, refused_url: allow.refused_url,
        strip_contents_of: allow.strip_contents_of, keep_comments: allow.keep_comments,
        link_rel: allow.link_rel }

// with_tag is the list with one more element allowed.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     let allow = htmlsafe.with_tag(htmlsafe.allow_basic(), "details")
//     println("${list.contains(allow.tags, "details")}")   // true
// ```
pub fn with_tag(allow: HtmlAllowList, tag: Str) -> HtmlAllowList []
    if list.contains(allow.tags, tag)
        return allow
    with_tags(allow, list.concat(allow.tags, [tag]))

// without_tag is the list with one element no longer allowed.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     let allow = htmlsafe.without_tag(htmlsafe.allow_readme(), "img")
//     println("${list.contains(allow.tags, "img")}")   // false
// ```
pub fn without_tag(allow: HtmlAllowList, tag: Str) -> HtmlAllowList []
    with_tags(allow, list.filter(allow.tags, t => t != tag))

// with_attr_rule is the list with the attribute rule for one element
// replaced, or added when it had none.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     let rule = HtmlAttrRule { tag: "a", attrs: ["href", "title"], url_attrs: ["href"] }
//     println("${list.len(htmlsafe.with_attr_rule(htmlsafe.allow_basic(), rule).attrs)}")   // 1
// ```
pub fn with_attr_rule(allow: HtmlAllowList, rule: HtmlAttrRule) -> HtmlAllowList []
    var rules = list.filter(allow.attrs, r => r.tag != rule.tag)
    rules = list.push(rules, rule)
    HtmlAllowList {
        tags: allow.tags, attrs: rules, url_schemes: allow.url_schemes,
        allow_relative_urls: allow.allow_relative_urls, refused_url: allow.refused_url,
        strip_contents_of: allow.strip_contents_of, keep_comments: allow.keep_comments,
        link_rel: allow.link_rel }

// ---------------------------------------------------------------------
// URLs.

// A URL as a browser reads it: references decoded, spaces and control
// characters removed from both ends, tabs and line breaks removed
// everywhere.
fn url_as_read(url: Str) -> Str
    let decoded = htmlentity.decode_scan(url, 0, str.len(url), true).text
    let n = str.len(decoded)
    var lo = 0
    while lo != n and str.byte_at_or(decoded, lo, 0) <= ' '
        lo = lo + 1
    var hi = n
    while hi > lo and str.byte_at_or(decoded, hi - 1, 0) <= ' '
        hi = hi - 1
    let sb = str.builder_new_cap(hi - lo)
    for i in lo..hi
        let b = str.byte_at_or(decoded, i, 0)
        if b != '\t' and b != '\n' and b != '\r'
            str.builder_append_char(sb, b)
    let out = str.builder_to_str(sb)
    str.builder_drop(sb)
    out

// A URL's scheme in lower case, or an empty string when it has none.
// A scheme is a letter, then letters, digits, `+`, `-` and `.`, then a
// colon (RFC 3986 section 3.1).
fn scheme_of(url: Str) -> Str
    let n = str.len(url)
    let first = str.byte_at_or(url, 0, 0)
    if not (first >= 'a' and first <= 'z' or first >= 'A' and first <= 'Z')
        return ""
    for i in 1..n
        let b = str.byte_at_or(url, i, 0)
        if b == ':'
            return lower_str(str.slice(url, 0, i))
        let ok = b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b >= '0' and b <= '9' or b == '+' or b == '-' or b == '.'
        if not ok
            return ""
    ""

// A string with ASCII upper case lowered.
fn lower_str(s: Str) -> Str
    let sb = str.builder_new_cap(str.len(s))
    for i in 0..str.len(s)
        let b = str.byte_at_or(s, i, 0)
        if b >= 'A' and b <= 'Z'
            str.builder_append_char(sb, b + 32)
        else
            str.builder_append_char(sb, b)
    let out = str.builder_to_str(sb)
    str.builder_drop(sb)
    out

// safe_url is the URL when the policy admits it, and `None` when it
// does not.
//
// The scheme is read as a browser reads it (see the module comment).
// A URL with a scheme is admitted when the scheme is in `url_schemes`.
// A URL that starts with `//` takes the page's scheme, and is admitted
// when `http` or `https` is.  Any other URL with no scheme is admitted
// when `allow_relative_urls` is set.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     let allow = htmlsafe.allow_readme()
//     println(htmlsafe.safe_url("java&#09;script:alert(1)", allow) ?? "refused")   // refused
// ```
pub fn safe_url(url: Str, allow: HtmlAllowList) -> ?Str []
    let read = url_as_read(url)
    let scheme = scheme_of(read)
    if scheme != ""
        if list.contains(allow.url_schemes, scheme)
            return Some(url)
        return None
    if str.starts_with(read, "//")
        if list.contains(allow.url_schemes, "https") or list.contains(allow.url_schemes, "http")
            return Some(url)
        return None
    if allow.allow_relative_urls
        return Some(url)
    None

// Whether a URL leaves the site: it has a scheme or starts with `//`.
fn external(url: Str) -> Bool
    let read = url_as_read(url)
    scheme_of(read) != "" or str.starts_with(read, "//")

// ---------------------------------------------------------------------
// Sanitising.

// The copy of a document being made: the links of every node as
// parallel lists, the bytes appended to the source for values the
// sanitiser wrote, and the nodes it left out.
struct HtmlCopy
    var source: Str
    var kinds: [htmltree.HtmlKind]
    var parents: [Int]
    var firsts: [Int]
    var lasts: [Int]
    var nexts: [Int]
    var prevs: [Int]
    var spans: [htmltree.HtmlRange]
    var extra: Str
    var removed: [Int]

// What the policy does with an element: keep it, unwrap it, or strip
// it with its contents.
fn verdict(allow: HtmlAllowList, tag: Str) -> Int
    if list.contains(allow.strip_contents_of, tag)
        return 2
    if list.contains(allow.tags, tag)
        return 0
    1

// Appends a node to the copy under `parent`, and answers its index.
fn copy_add(var c: HtmlCopy, parent: Int, kind: htmltree.HtmlKind, sp: htmltree.HtmlRange) -> Int
    let index = list.len(c.kinds)
    let prev = c.lasts[parent]
    c.kinds = list.push(c.kinds, kind)
    c.parents = list.push(c.parents, parent)
    c.firsts = list.push(c.firsts, NO_NODE)
    c.lasts = list.push(c.lasts, NO_NODE)
    c.nexts = list.push(c.nexts, NO_NODE)
    c.prevs = list.push(c.prevs, prev)
    c.spans = list.push(c.spans, sp)
    if prev == NO_NODE
        c.firsts[parent] = index
    else
        c.nexts[prev] = index
    c.lasts[parent] = index
    index

// The range of a string the sanitiser writes, appended after the
// source.
fn written(var c: HtmlCopy, text: Str) -> htmltree.HtmlRange
    let start = str.len(c.source) + str.len(c.extra)
    c.extra = c.extra + text
    HtmlRange { start: start, end: start + str.len(text) }

// The attribute names and the URL attribute names a policy keeps on an
// element.
fn kept_names(allow: HtmlAllowList, tag: Str, urls: Bool) -> [Str]
    var out: [Str] = []
    for r in allow.attrs
        if r.tag == tag or r.tag == "*"
            if urls
                out = list.concat(out, r.url_attrs)
            else
                out = list.concat(out, r.attrs)
    out

// The attributes an element keeps under a policy, with each refused URL
// replaced and a `rel` added to a link that leaves the site.
fn kept_attrs(var c: HtmlCopy, doc: htmltree.HtmlDoc, allow: HtmlAllowList, tag: Str,
              attrs: [htmltree.HtmlAttr]) -> [htmltree.HtmlAttr]
    let names = kept_names(allow, tag, false)
    let urls = kept_names(allow, tag, true)
    var out: [htmltree.HtmlAttr] = []
    var seen: [Str] = []
    var leaves = false
    for a in attrs
        let name = str.slice(doc.source, a.name.start, a.name.end)
        if list.contains(seen, name) or not list.contains(names, name) or name == "rel" and allow.link_rel != "" and tag == "a"
            continue
        seen = list.push(seen, name)
        if not list.contains(urls, name)
            out = list.push(out, a)
            continue
        var value = str.slice(doc.source, a.value.start, a.value.end)
        if a.needs_decoding
            value = htmlentity.decode_scan(doc.source, a.value.start, a.value.end, true).text
        match safe_url(value, allow)
            Some(_) =>
                out = list.push(out, a)
                if external(value)
                    leaves = true
            None    =>
                out = list.push(out, HtmlAttr { name: a.name,
                    value: written(c, allow.refused_url),
                    needs_decoding: has_amp(allow.refused_url) })
    if tag == "a" and leaves and allow.link_rel != ""
        out = list.push(out, HtmlAttr { name: written(c, "rel"),
            value: written(c, allow.link_rel),
            needs_decoding: has_amp(allow.link_rel) })
    out

// Whether a string holds `&`.
fn has_amp(s: Str) -> Bool
    str.contains(s, "&")

// Copies the children of `index` under the copy's node `parent`.
fn copy_children(var c: HtmlCopy, doc: htmltree.HtmlDoc, index: Int, parent: Int,
                 allow: HtmlAllowList)
    var k = doc.nodes[index].first_child
    while k != NO_NODE
        let n = doc.nodes[k]
        match n.kind
            HtmlElement(tag_r, attrs) =>
                let tag = str.slice(doc.source, tag_r.start, tag_r.end)
                let v = verdict(allow, tag)
                if v == 0
                    let kept = kept_attrs(c, doc, allow, tag, attrs)
                    let child = copy_add(c, parent, HtmlElement(tag_r, kept), n.span)
                    copy_children(c, doc, k, child, allow)
                else
                    c.removed = list.push(c.removed, k)
                    if v == 1
                        copy_children(c, doc, k, parent, allow)
            HtmlText(_, _)            =>
                let _ = copy_add(c, parent, n.kind, n.span)
            HtmlComment(_)            =>
                if allow.keep_comments
                    let _ = copy_add(c, parent, n.kind, n.span)
                else
                    c.removed = list.push(c.removed, k)
            _                         =>
                c.removed = list.push(c.removed, k)
        k = n.next_sibling

// The copy of a document under a policy.
fn sanitized(doc: htmltree.HtmlDoc, allow: HtmlAllowList) -> HtmlCopy
    var c = HtmlCopy {
        source: doc.source, kinds: [HtmlDocument], parents: [NO_NODE], firsts: [NO_NODE],
        lasts: [NO_NODE], nexts: [NO_NODE], prevs: [NO_NODE],
        spans: [HtmlRange { start: 0, end: str.len(doc.source) }], extra: "", removed: [] }
    if list.len(doc.nodes) > 0
        copy_children(c, doc, 0, 0, allow)
    c

// sanitize is the document with everything the policy refuses removed.
//
// An element the policy does not allow is unwrapped: it goes and its
// children stay in its place.  An element in `strip_contents_of` goes
// with its contents.  An attribute not in the element's rule goes, a
// URL attribute whose value `safe_url` refuses gets `refused_url`
// instead, and a link that leaves the site gets `link_rel`.  Comments
// go unless `keep_comments` is set, and a doctype goes.
//
// The answer's source is the original with the values the sanitiser
// wrote appended, so every range still points into it.
//
// ```novo
// use htmlparse
// use htmlsafe
// use htmlwrite
//
// fn main() [io]
//     let doc = htmlparse.parse_fragment("<p onclick=\"x()\">hi</p>", "div")
//     let clean = htmlsafe.sanitize(doc, htmlsafe.allow_readme())
//     println(htmlwrite.serialize_str(clean, htmlwrite.default_options()))   // <p>hi</p>
// ```
pub fn sanitize(doc: htmltree.HtmlDoc, allow: HtmlAllowList) -> htmltree.HtmlDoc []
    let c = sanitized(doc, allow)
    var nodes: [htmltree.HtmlNode] = []
    for i in 0..list.len(c.kinds)
        nodes = list.push(nodes, HtmlNode {
            kind: c.kinds[i], parent: c.parents[i], first_child: c.firsts[i],
            last_child: c.lasts[i], next_sibling: c.nexts[i], previous_sibling: c.prevs[i],
            span: c.spans[i] })
    HtmlDoc { source: c.source + c.extra,
        nodes: nodes,
        issues: doc.issues,
        truncated: doc.truncated }

// sanitize_removals is the index of every node `sanitize` would remove,
// in document order, without removing it.  A node removed with its
// contents is listed and its contents are not.
//
// ```novo
// use htmlparse
// use htmlsafe
//
// fn main() [io]
//     let doc = htmlparse.parse_fragment("<p>a</p><script>b</script>", "div")
//     println("${list.len(htmlsafe.sanitize_removals(doc, htmlsafe.allow_readme()))}")   // 1
// ```
pub fn sanitize_removals(doc: htmltree.HtmlDoc, allow: HtmlAllowList) -> [Int] []
    sanitized(doc, allow).removed

// ---------------------------------------------------------------------
// Escaping.

// The bytes of a string.
fn wire(s: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(s))

// escape_text is `out` with text appended, `&`, `<` and `>` escaped:
// the three that matter in element content.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.len(htmlsafe.escape_text([], "a<b"))}")   // 6
// ```
pub fn escape_text(out: [u8], text: Str) -> [u8] []
    list.concat(out, wire(escape_text_str(text)))

// escape_attr is `out` with text appended, `&`, `<`, `>`, `"` and `'`
// escaped.  The quotes are what stop a value from ending its attribute.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.len(htmlsafe.escape_attr([], "\""))}")   // 6
// ```
pub fn escape_attr(out: [u8], text: Str) -> [u8] []
    list.concat(out, wire(escape_attr_str(text)))

// escape_text_str is `escape_text` into a new string.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println(htmlsafe.escape_text_str("a<b>&c"))   // a&lt;b&gt;&amp;c
// ```
pub fn escape_text_str(text: Str) -> Str []
    escaped(text, false)

// escape_attr_str is `escape_attr` into a new string.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println(htmlsafe.escape_attr_str("a\"b'c"))   // a&quot;b&#39;c
// ```
pub fn escape_attr_str(text: Str) -> Str []
    escaped(text, true)

// Text with the text escapes, and the quote escapes when `quotes` is
// set.
fn escaped(text: Str, quotes: Bool) -> Str
    let sb = str.builder_new_cap(str.len(text))
    for i in 0..str.len(text)
        let b = str.byte_at_or(text, i, 0)
        if b == '&'
            let _ = str.builder_append(sb, "&amp;")
        else if b == '<'
            let _ = str.builder_append(sb, "&lt;")
        else if b == '>'
            let _ = str.builder_append(sb, "&gt;")
        else if quotes and b == '"'
            let _ = str.builder_append(sb, "&quot;")
        else if quotes and b == '\''
            let _ = str.builder_append(sb, "&#39;")
        else
            str.builder_append_char(sb, b)
    let out = str.builder_to_str(sb)
    str.builder_drop(sb)
    out

// unescape resolves every character reference in text, as HTML's
// tokenizer does in element content (section 13.2.5.72).
//
// A legacy name without its semicolon is resolved, so `&amp b` is
// `& b`.  A number that is 0, a surrogate or past U+10FFFF becomes
// U+FFFD.  A name that is not in the table stays as it was written.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println(htmlsafe.unescape("&lt;&#65;&#x42;&amp"))   // <AB&
// ```
pub fn unescape(text: Str) -> Str []
    htmlentity.decode_scan(text, 0, str.len(text), false).text

// unescape_into is `out` with the text `unescape` answers appended.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.len(htmlsafe.unescape_into([], "&amp;"))}")   // 1
// ```
pub fn unescape_into(out: [u8], text: Str) -> [u8] []
    list.concat(out, wire(unescape(text)))

// named_reference is the code points a named character reference
// stands for, the name given without `&` and with or without its `;`,
// or `None`.
//
// A few references are two code points: `NotEqualTilde` is U+2242
// U+0338.
//
// ```novo
// use htmlsafe
//
// fn main() [io]
//     println("${list.len(htmlsafe.named_reference("NotEqualTilde") ?? [])}")   // 2
// ```
pub fn named_reference(name: Str) -> ?[Int] []
    if str.ends_with(name, ";")
        return htmlentity.codes_of(name)
    htmlentity.codes_of(name + ";") ?? htmlentity.codes_of(name)
