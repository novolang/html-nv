@test
fn test_html5lib_tokenizer_rows_15() [io]
    var n = 6000
    for row in rows_15()
        let (input, state, last, want) = row
        n = n + 1
        test.case("row ${n}")
        test.assert_eq_str(tokens_text(htmlparse.tokenizer_state(input, state, last, false)), want)

