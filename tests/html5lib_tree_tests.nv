@test
fn test_html5lib_tree_rows_0() [io]
    var n = 0
    for row in rows_0()
        let (input, context, want) = row
        n = n + 1
        test.case("row ${n}")
        test.assert_eq_str(dump(parsed(input, context)), want)

// Rows 201 to 219.
fn rows_1() -> [(Str, Str, Str)]
    [
        ("<!DOCTYPEhtml>Hello", "", "| <!DOCTYPE html>\n| \"Hello\""),
        ("<!DOCTYPE>Hello", "", "| <!DOCTYPE >\n| \"Hello\""),
        ("<!DOCTYPE >Hello", "", "| <!DOCTYPE >\n| \"Hello\""),
        ("<!DOCTYPE potato>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato >Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato taco>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato taco \"ddd>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato sYstEM>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato sYstEM    >Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE   potato       sYstEM  ggg>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato SYSTEM taco  >Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato SYSTEMtaco \"ddd\">Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato grass SYSTEM taco>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato pUbLIc>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato pUbLIc >Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato pUbLIcgoof>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE potato PUBLIC goof>Hello", "", "| <!DOCTYPE potato>\n| \"Hello\""),
        ("<!DOCTYPE ...>Hello", "", "| <!DOCTYPE ...>\n| \"Hello\""),
        ("<!DOCTYPE root-element [SYSTEM OR PUBLIC FPI] \"uri\" [ \n<!-- internal declarations -->\n]>",
        "",
        "| <!DOCTYPE root-element>\n| \"]>\"")]

@test
fn test_html5lib_tree_rows_1() [io]
    var n = 200
    for row in rows_1()
        let (input, context, want) = row
        n = n + 1
        test.case("row ${n}")
        test.assert_eq_str(dump(parsed(input, context)), want)

// The inputs whose trees depend on the adoption agency algorithm.
fn misnested() -> [Str]
    [
        "<a><p>X<a>Y</a>Z</p></a>",
        "<p><b><div><marquee></p></b></div>X",
        "<a X>0<b>1<a Y>2",
        "<b><p></b>TEST",
        "<b id=a><p><b id=b></p></b>TEST",
        "<font><p>hello<b>cruel</font>world",
        "<b>A<cite>B<div>C</b>D",
        "<DIV> abc <B> def <I> ghi <P> jkl </B>",
        "<DIV> abc <B> def <I> ghi <P> jkl </B> mno",
        "<DIV> abc <B> def <I> ghi <P> jkl </B> mno </I>",
        "<DIV> abc <B> def <I> ghi <P> jkl </B> mno </I> pqr",
        "<DIV> abc <B> def <I> ghi <P> jkl </B> mno </I> pqr </P>",
        "<DIV> abc <B> def <I> ghi <P> jkl </B> mno </I> pqr </P> stu",
        "<wbr><strike><code></strike><code><strike></code>",
        "<a><p><a></a></p></a>",
        "<p><b><div><marquee></p></b></div>",
        "<!DOCTYPE html><font><p><b>test</font>",
        "<b>a<div></div><div></b>y",
        "<a><div><p></a>"]

// Whether a document reports a construct outside the subset.
fn reports_unsupported(doc: HtmlDoc) -> Bool
    for issue in doc.issues
        match issue.kind
            IssueUnsupportedConstruct(_) =>
                return true
            _                            => ()
    false

@test
fn test_each_misnested_case_is_reported_rather_than_repaired() [io]
    for input in misnested()
        test.case(input)
        test.assert(reports_unsupported(htmlparse.parse(input)))
